[node name="ScrollContainer" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="ScrollContainer/VBox"]
layout_mode = 2
theme_type_variation = &"title"
text = "NinePatchRect 切片编辑 · 选中节点 → Inspector → Patch Margin 调值 → 拖控件角手柄看拉伸效果"

[node name="InstructionsLabel" type="Label" parent="ScrollContainer/VBox"]
layout_mode = 2
theme_type_variation = &"body"
text = "操作方式：\n1. 在节点树选中某个 NP_xxx\n2. Inspector → Axis Stretch 下方有 Patch Margin 四个字段（Left/Top/Right/Bottom）\n3. 拖数值观察四角装饰是否完整（装饰被拉伸说明数值太小）\n4. 在 2D 视图里拉控件的角手柄改控件尺寸，看中心平铺区有没有变形\n5. 满意后把最终四个数字告诉 Manager"
autowrap_mode = 3

[node name="Section_MainPanel" type="VBoxContainer" parent="ScrollContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="ScrollContainer/VBox/Section_MainPanel"]
layout_mode = 2
theme_type_variation = &"section"
text = "1. main_panel (1536×1024)"

[node name="Hint" type="Label" parent="ScrollContainer/VBox/Section_MainPanel"]
layout_mode = 2
theme_type_variation = &"caption"
text = "推荐初始 patch_margin: left=180 top=140 right=180 bottom=140（仅供起点，请按实际切）"
