[node name="TitleLabel" type="Label" parent="ScrollContainer/VBox" unique_id=139047657]
layout_mode = 2
theme_type_variation = &"title"
text = "NinePatchRect 切片编辑 · 选中节点 → Inspector → Patch Margin 调值 → 拖控件角手柄看拉伸效果"

[node name="InstructionsLabel" type="Label" parent="ScrollContainer/VBox" unique_id=1777735993]
layout_mode = 2
theme_type_variation = &"body"
text = "操作方式：
1. 在节点树选中某个 NP_xxx
2. Inspector → Axis Stretch 下方有 Patch Margin 四个字段（Left/Top/Right/Bottom）
3. 拖数值观察四角装饰是否完整（装饰被拉伸说明数值太小）
4. 在 2D 视图里拉控件的角手柄改控件尺寸，看中心平铺区有没有变形
5. 满意后把最终四个数字告诉 Manager"
autowrap_mode = 3

