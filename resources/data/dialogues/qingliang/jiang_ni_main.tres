[sub_resource type="Resource" id="DialogueNode_start"]
script = ExtResource("2_dialogue_node")
node_id = "start"
speaker_id = "jiang_ni"
speaker_name_override = ""
text = "你来得倒巧。我刚想清静一会儿，偏又看见你。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "reply"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([SubResource("DialogueAction_set_jiang_met")])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_reply"]
script = ExtResource("2_dialogue_node")
node_id = "reply"
speaker_id = "xu_fengnian"
speaker_name_override = "徐凤年"
text = "清凉山风冷，我怕你一个人站久了，连怨气都冻住。"
choices = Array[ExtResource("3_dialogue_choice")]([SubResource("DialogueChoice_soften"), SubResource("DialogueChoice_tease")])
next_node_id = ""
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_soften"]
script = ExtResource("2_dialogue_node")
node_id = "soften"
speaker_id = "jiang_ni"
speaker_name_override = ""
text = "少装好心。你若真懂冷暖，就不该总拿旧事刺人。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "close"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_tease"]
script = ExtResource("2_dialogue_node")
node_id = "tease"
speaker_id = "jiang_ni"
speaker_name_override = ""
text = "再贫嘴，我便把你赶下山。北凉世子，也未必摔不疼。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "close"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_close"]
