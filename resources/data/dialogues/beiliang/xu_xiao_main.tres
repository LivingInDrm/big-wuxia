on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_road"]
script = ExtResource("2_dialogue_node")
node_id = "road"
speaker_id = "xu_xiao"
speaker_name_override = ""
text = "武当那帮道士眼高，你去碰一碰，才知天下门槛多高。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "advice"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_people"]
script = ExtResource("2_dialogue_node")
node_id = "people"
speaker_id = "xu_xiao"
speaker_name_override = ""
text = "该见的人，自会见你。到了山里，少耍世子脾气。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "advice"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_advice"]
script = ExtResource("2_dialogue_node")
node_id = "advice"
speaker_id = "xu_xiao"
speaker_name_override = ""
text = "出门在外，刀可慢拔，眼要放亮。北凉的脸，别丢。"
choices = Array[ExtResource("3_dialogue_choice")]([])
next_node_id = "farewell"
on_enter_actions = Array[ExtResource("4_dialogue_action")]([])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_farewell"]
script = ExtResource("2_dialogue_node")
node_id = "farewell"
speaker_id = "xu_xiao"
speaker_name_override = ""
text = "去吧。路上若吃了亏，记住先忍一口气。"
choices = Array[ExtResource("3_dialogue_choice")]([])
