on_enter_actions = Array[ExtResource("4_dialogue_action")]([SubResource("DialogueAction_set_met")])
on_exit_actions = Array[ExtResource("4_dialogue_action")]([])
required_flags = Array[String]([])
forbidden_flags = Array[String]([])

[sub_resource type="Resource" id="DialogueNode_charge"]
script = ExtResource("2_dialogue_node")
node_id = "charge"
speaker_id = "xu_xiao"
speaker_name_override = ""
text = "先上武当会友，再去清凉山寻人。"
choices = Array[ExtResource("3_dialogue_choice")]([SubResource("DialogueChoice_ask_road"), SubResource("DialogueChoice_ask_people"), SubResource("DialogueChoice_accept")])
